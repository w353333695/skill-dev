{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knodo.local/schemas/meeting-semantic-input-v1.schema.json",
  "title": "Meeting semantic input v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_version",
    "snapshot",
    "title_policy",
    "segments",
    "speaker_catalog",
    "numeric_candidates",
    "claim_slots",
    "topic_slots",
    "chapter_slots",
    "viewpoint_slots",
    "decision_slots",
    "action_slots"
  ],
  "properties": {
    "input_version": {
      "const": "1.0"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meeting_id",
        "source_attempt_id",
        "transcript_sha256"
      ],
      "properties": {
        "meeting_id": {
          "type": "string",
          "minLength": 1
        },
        "source_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "background": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "user_edited"
      ],
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_edited": {
          "type": "boolean"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "start_ms",
          "end_ms",
          "speaker_id",
          "text"
        ],
        "properties": {
          "sequence": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "speaker_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker_id",
          "role"
        ],
        "properties": {
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "numeric_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "sequence",
          "surface",
          "value",
          "unit"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "claim_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "sequences",
          "speaker_ids",
          "numeric_candidate_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "sequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "speaker_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numeric_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "topic_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          }
        }
      }
    },
    "chapter_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "start_seconds",
          "end_seconds"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "end_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "viewpoint_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          }
        }
      }
    },
    "decision_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          }
        }
      }
    },
    "action_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
