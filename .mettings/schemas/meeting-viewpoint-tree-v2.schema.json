{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knodo.local/schemas/meeting-viewpoint-tree-v2.schema.json",
  "title": "Meeting Viewpoint Tree V2",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_sequences"
      ],
      "properties": {
        "segment_sequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "speakers",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "status": {
      "enum": [
        "consensus",
        "disagreement",
        "tentative",
        "unresolved",
        "context"
      ]
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "text",
        "speakers",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "consensus",
            "disagreement",
            "tentative",
            "unresolved"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "pointNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "claim"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "const": "point"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "claim": {
          "$ref": "#/$defs/claim"
        }
      }
    },
    "listNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "const": "list"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "items"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "columnsNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "columns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "const": "columns"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "speakers",
        "evidence"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "speakers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "tableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "status",
        "columns",
        "rows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "const": "table"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/tableRow"
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointNode"
        },
        {
          "$ref": "#/$defs/listNode"
        },
        {
          "$ref": "#/$defs/columnsNode"
        },
        {
          "$ref": "#/$defs/tableNode"
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "tone",
        "nodes",
        "conclusion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tone": {
          "enum": [
            "amber",
            "blue",
            "green",
            "purple",
            "neutral"
          ]
        },
        "nodes": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "conclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/conclusion"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "viewpointTreeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "meeting_id",
        "title",
        "transcript_sha256",
        "generated_at",
        "sections"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "meeting_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "artifact",
        "attempt_id",
        "generation_sequence",
        "transcript_sha256",
        "prompt_id",
        "prompt_version",
        "generated_at"
      ],
      "dependentRequired": {
        "conversation_id": [
          "response_id"
        ],
        "response_id": [
          "conversation_id"
        ],
        "model_key": [
          "model",
          "sdk_type",
          "effort_level",
          "routing_policy_version",
          "routing_selection_mode",
          "routing_config_source"
        ],
        "routing_selection_mode": [
          "model_key",
          "model",
          "sdk_type",
          "effort_level",
          "routing_policy_version",
          "routing_config_source"
        ]
      },
      "anyOf": [
        {
          "required": [
            "conversation_id",
            "response_id"
          ]
        },
        {
          "required": [
            "recovery_reason"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "recovery_reason"
            ],
            "properties": {
              "recovery_reason": {
                "const": "chat_timeout_reconciled"
              }
            }
          },
          "then": {
            "required": [
              "conversation_id",
              "response_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "routing_selection_mode"
            ],
            "properties": {
              "routing_selection_mode": {
                "const": "policy"
              }
            }
          },
          "then": {
            "required": [
              "routing_policy_rule",
              "routing_match_kind",
              "routing_match_index",
              "candidate_rank"
            ],
            "not": {
              "required": [
                "discovery_option_index"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "routing_selection_mode"
            ],
            "properties": {
              "routing_selection_mode": {
                "const": "discovery-order-fallback"
              }
            }
          },
          "then": {
            "required": [
              "discovery_option_index"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "routing_policy_rule"
                  ]
                },
                {
                  "required": [
                    "routing_match_kind"
                  ]
                },
                {
                  "required": [
                    "routing_match_index"
                  ]
                },
                {
                  "required": [
                    "candidate_rank"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "routing_selection_mode"
            ],
            "properties": {
              "routing_selection_mode": {
                "const": "config-default-fallback"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "routing_policy_rule"
                  ]
                },
                {
                  "required": [
                    "routing_match_kind"
                  ]
                },
                {
                  "required": [
                    "routing_match_index"
                  ]
                },
                {
                  "required": [
                    "candidate_rank"
                  ]
                },
                {
                  "required": [
                    "discovery_option_index"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "artifact": {
          "const": "viewpoint_tree"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "generation_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "response_id": {
          "type": "string",
          "minLength": 1
        },
        "model_key": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sdk_type": {
          "enum": [
            "codex",
            "claude-code"
          ]
        },
        "effort_level": {
          "enum": [
            "auto",
            "disabled",
            "low",
            "medium",
            "high"
          ]
        },
        "routing_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "routing_selection_mode": {
          "enum": [
            "policy",
            "config-default-fallback",
            "discovery-order-fallback"
          ]
        },
        "routing_policy_rule": {
          "type": "string",
          "minLength": 1
        },
        "routing_match_kind": {
          "enum": [
            "exact",
            "glob"
          ]
        },
        "routing_match_index": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_rank": {
          "type": "integer",
          "minimum": 1
        },
        "discovery_option_index": {
          "type": "integer",
          "minimum": 0
        },
        "routing_config_source": {
          "enum": [
            "live",
            "fresh-cache",
            "stale-cache"
          ]
        },
        "recovery_reason": {
          "enum": [
            "tool_audit_bypassed",
            "chat_timeout_reconciled"
          ]
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generatedViewpointTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "meeting_id",
        "title",
        "transcript_sha256",
        "generated_at",
        "sections",
        "generation"
      ],
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "meeting_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "generation": {
          "$ref": "#/$defs/generation"
        }
      }
    }
  },
  "$ref": "#/$defs/viewpointTreeDocument"
}
