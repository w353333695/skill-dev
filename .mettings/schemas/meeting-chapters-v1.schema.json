{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knodo.local/schemas/meeting-chapters-v1.schema.json",
  "title": "Meeting chapters v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chapters"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "start_seconds",
          "end_seconds",
          "title",
          "summary"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "end_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
