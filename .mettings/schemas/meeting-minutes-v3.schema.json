{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knodo.local/schemas/meeting-minutes-v3.schema.json",
  "title": "Meeting minutes v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "metadata",
    "core_topics",
    "content_markdown",
    "decisions",
    "action_items"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "core_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_markdown": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "(^|\\n)\\s{0,3}#(?:\\s|$)"
          },
          {
            "pattern": "(^|\\n)\\s{0,3}#{4,6}(?:\\s|$)"
          },
          {
            "pattern": "\\n\\s{0,3}(?:=+|-+)\\s*(?:\\n|$)"
          },
          {
            "pattern": "(^|\\n)\\s*(?:[-+*]\\s+)?\\[[ xX]\\](?:\\s|$)"
          },
          {
            "pattern": "</?[A-Za-z][^>]*>|<!--"
          },
          {
            "pattern": "!\\[[^\\]]*\\]\\s*\\("
          },
          {
            "pattern": "(?:https?|ftp)://\\S+|mailto:\\S+"
          },
          {
            "pattern": "(^|[^0-9])(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?![0-9])"
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action_item"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "time_text",
        "participants",
        "mentioned_non_speakers"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "time_text": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "mentioned_non_speakers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "joined_at_seconds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "joined_at_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "status",
        "content"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "consensus",
            "disagreement",
            "tentative",
            "deferred",
            "unresolved"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "content",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        }
      }
    }
  }
}
