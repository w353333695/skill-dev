{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knodo.local/schemas/meeting-semantic-patch-v1.schema.json",
  "title": "Meeting semantic patch v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patch_version"
  ],
  "properties": {
    "patch_version": {
      "const": "1.0"
    },
    "subject": {
      "type": "string"
    },
    "executive_summary": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "text",
          "importance",
          "kind"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "core",
              "supporting"
            ]
          },
          "kind": {
            "enum": [
              "fact",
              "position",
              "rule",
              "decision",
              "outlook"
            ]
          },
          "speaker_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "numeric_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "title",
          "claim_slot_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "claim_slot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "title",
          "claim_slot_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "claim_slot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "status",
          "claim_slot_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "tentative",
              "unresolved",
              "rejected",
              "deferred"
            ]
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "claim_slot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "content",
          "owner_speaker_id",
          "claim_slot_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "owner_speaker_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim_slot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "participant_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker_id",
          "role"
        ],
        "properties": {
          "speaker_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          }
        }
      }
    },
    "viewpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "title"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "enum": [
              "amber",
              "blue",
              "green",
              "purple",
              "neutral"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "point",
                    "list",
                    "table",
                    "columns"
                  ]
                },
                "claim_slot_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "claim_slot_ids"
                    ],
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "claim_slot_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "cells": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "claim_slot_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "conclusion_claim_slot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conclusion_status": {
            "type": "string"
          }
        }
      }
    }
  }
}
