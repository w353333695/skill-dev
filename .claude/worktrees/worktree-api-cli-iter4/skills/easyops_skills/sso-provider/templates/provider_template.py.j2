    def custom_auth(self, params):
        """
        自定义密码校验（可选实现）

        用于非 SSO 场景下的用户名密码验证。
        如果不需要此功能，返回 False 即可。

        Args:
            params (dict): 包含 username 和 password 的字典

        Returns:
            bool: 验证通过返回 True，否则返回 False
        """
        # 注意：请求参数包含密码，请勿打印完整参数
        safe_params = dict(params)
        if "password" in safe_params:
            safe_params["password"] = "******"
        logging.info(u"[{{ provider_name }}] custom_auth, params: %s", json.dumps(safe_params))
        return False

