    def __init__(self):
        """初始化 {{ provider_name }} provider，加载并校验配置"""
        {% if base_class == 'oauth2' %}
        oauth2.__init__(self)
        {% else %}
        Provider.__init__(self)
        {% endif %}
        self._config = PLUGIN_CONFIG.get("{{ provider_name }}")
        if self._config is None:
            raise Exception(
                u"导入{{ provider_name }}模块异常, "
                u"setting.py中PLUGIN_CONFIG.{{ provider_name }}配置不存在"
            )

        # 配置校验 schema
        config_schema = {
            "type": "object",
            "properties": {
                {% for prop in config_properties %}
                "{{ prop.name }}": {"type": "{{ prop.type }}"},
                {% endfor %}
            },
            "required": [{% for req in config_required %}"{{ req }}"{% if not loop.last %}, {% endif %}{% endfor %}]
        }
        try:
            validate(instance=self._config, schema=config_schema)
        except Exception, e:
            raise Exception(
                u"导入{{ provider_name }}模块异常, "
                u"setting.py中PLUGIN_CONFIG.{{ provider_name }}格式非法: %s" % b2s(e.message)
            )

        {% if needs_redirect_uri_parse %}
        # 解析重定向 URI，构建回调地址
        parsed_url = urlparse(self._config["redirect_uri"])
        port = parsed_url.port
        if not port:
            port = 80
        self._redirect_uri = "{scheme}://{hostname}:{port}/next/sso-auth/authorize".format(
            scheme=parsed_url.scheme,
            hostname=parsed_url.hostname,
            port=port
        )
        {% endif %}

