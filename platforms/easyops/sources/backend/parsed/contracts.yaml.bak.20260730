- operation_key: logic.data_exchange|POST|/api/v1/data_exchange/tsdb_column/query
  method: POST
  path: /api/v1/data_exchange/tsdb_column/query
  raw_paths:
    backend: /api/v1/data_exchange/tsdb_column/query
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.data_exchange
  request:
    fields:
    - name: database
      type: string
      desc: org
    - name: object_ids
      type: string[]
      desc: 列存储模型名
    - name: filed
      type: string[]
      desc: 拼写错误废弃字段，与field一致，同时传入则使用此字段。
    - name: fields
      type: string[]
      desc: 返回属性列表；字符串数组；只返回需要的数据，需要返回所有字段时，带上 *
    - name: filter
      type: map
      desc: 过滤条件；Struct；与easy_core的查询filter基本一致
    - name: start_time
      type: int64
      desc: 查询的开始时间，单位毫秒；整型；包括当前时间点
    - name: end_time
      type: int64
      desc: 查询的结束时间，单位毫秒；整型；不包括当前时间点
    - name: limit
      type: int64
      desc: 数据数量大小限制
    - name: next_token
      type: string
      desc: 分页token，字符串；向上翻页或向下翻页的token都在这个参数传入。
    - name: is_local
      type: bool
      desc: 是否本地
    - name: distinct
      type: bool
      desc: 是否去重
    - name: sorts
      type: ColumnSort[]
      desc: ColumnSort类型，可以参考tsdb column_object.ColumnSort的定义；暂时不要传值，性能有问题
    - name: func_fields
      type: UserFunc[]
      desc: 和fields一起返回数据，名字会覆盖fields的值；UserFunc类型数组
