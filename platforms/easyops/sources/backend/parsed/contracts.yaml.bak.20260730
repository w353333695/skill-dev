  raw_paths:
    backend: /api/v1/demand_manager/demand/list
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.custom_demand_manager
  request:
    fields:
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: fields
      type: string[]
      desc: '指定返回字段, e.g.: [name, instanceId]'
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: sort
      type: map
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: { instanceId:
        1 }'
    - name: onlyMyInstance
      type: bool
      desc: 是否只查询与我相关的数据
    - name: demandPhase
      type: string
      desc: 需求阶段：实施中、反馈中、异常
    - name: demandStatusGroup
      type: string
      desc: 需求状态组：实施中、已完成
    - name: startDate
      type: string
      desc: '开始日期, eg: 2022-11'
    - name: endDate
      type: string
      desc: '结束日期, eg: 2022-12'
    - name: department
      type: string[]
      desc: 业务部门：需求提出部门
    - name: ownLine
      type: string[]
      desc: 所属条线
    - name: reqEmergencyLevel
      type: string[]
      desc: 需求紧急程度：紧急需求; 非紧急需求
    - name: isAbnormal
      type: string
      desc: 需求是否异常：是/否
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
