- operation_key: logic.blueprint|POST|/api/blueprint/v1/apply
  method: POST
  path: /api/blueprint/v1/apply
  raw_paths:
    backend: /api/blueprint/v1/apply
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.blueprint
  request:
    fields:
    - name: blueprintInstanceId
      type: instance_id
      desc: 蓝图实例ID，新增的场景为空，变更的场景有值
    - name: blueprintInstanceName
      type: string
      desc: 蓝图实例名称
    - name: blueprintTemplateInstanceId
      type: instance_id
      desc: 蓝图模板的cmdb实例id
    - name: blueprintENVId
      type: instance_id
      desc: 蓝图环境实例id
    - name: fromReleasePlan
      type: bool
      desc: 是否来源于发布单
    - name: onlyBlueprint
      type: bool
      desc: 是否只执行蓝图，不判断pipeline
    - name: releasePlanLogId
      type: string
      desc: 发布单历史ID
    - name: providerList
      type: ExecProvider[]
      desc: 混合部署的provider id列表, id为cmdb的实例id
    - name: serviceSetId
      type: instance_id
      desc: 服务集id
    - name: inputs
      type: ExecInput[]
      desc: 输入集合
    - name: mergeOldInput
      type: bool
      desc: 当mergeOldInput为true时，会捞蓝图里面已有的值，然后跟传过来的input进行合并；为false就直接全部用传过来的值
    - name: ignoreDeployment
      type: bool
      desc: 是否忽略deployment的执行
    - name: predownloadTaskId
      type: string
      desc: 制品预下载的taskId
    - name: extInfo
      type: object
      desc: extinfo
    - name: easyopsConfSpec
      type: object[]
      desc: 主机部署的配置包信息，部署路径后台从蓝图获取
    - name: workflowInfo
      type: object
      desc: workflow信息
    - name: allowDowngrade
      type: string
      desc: 主机部署、容器部署是否允许降级，true, false；默认为空，系统默认逻辑
    - name: changeType
      type: string
      desc: 类型，deploy 部署；reload 配置重载；resize 扩缩容；rollback 回滚；upgrade 制品升级
    - name: historyId
      type: string
      desc: '历史id: 重试部署时更新该id'
    - name: deployBatchNum
      type: int
      desc: 并行部署主机数
    - name: deployBatchPercentage
      type: float
      desc: 并行部署主机百分比
    - name: platformEnvMap
      type: map
      desc: 平台级环境变量
    - name: abnormalFiles
      type: object[]
      desc: 篡改的文件
  response:
    fields:
    - name: blueprintInstanceId
      type: instance_id
      desc: 蓝图实例ID
    - name: historyId
      type: string
      desc: 变更历史id
    - name: taskId
      type: string
      desc: 如果触发的是流水线，返回这个taskId
  semantic_gaps: []
  port: 8156
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
