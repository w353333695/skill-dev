    - name: diff
      type: string
      desc: 'json 序列化过后的版本差异列表, 其中 diff 中有 fromVersion, toVersion, detail 字段

        ''{"fromVersion": "ver_01", "toVersion": "ver_02", "detail": [{"encoding":
        "utf-8", "file": "/index.html", "newMd5": "c7e8812fa599cf915cf5db640974e885",
        "oldMd5": "c54408ca438cc74300d65df5c2f3f73c", "op": "M", "perm": "0644", "type":
        "file"}]}''

        '
  response:
