- operation_key: logic.resource_monitor|POST|/api/v1/application_performance_monitor/get_api_with_service_node
  method: POST
  path: /api/v1/application_performance_monitor/get_api_with_service_node
  raw_paths:
    backend: /api/v1/application_performance_monitor/get_api_with_service_node
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.resource_monitor
  request:
    fields:
    - name: model
      type: string
      desc: '1. dataSource 为 cmdb 时， model 为 "cmdb.model"

        2. dataSource 为 clickhouse 时， model 为 "库名.表名"

        '
    - name: query
      type: map
      desc: CMDB 过滤条件
    - name: dims
      type: string[]
      desc: 聚合的维度
    - name: measures
      type: Measure[]
      desc: 指标聚合计算规则
    - name: filters
      type: Filter[]
      desc: 过滤条件
    - name: order
      type: Order[]
      desc: 指定字段排序, 数组是有顺序，哪个字段在前，先按哪个字段排序
    - name: limit
      type: Limit
      desc: 指定获取数据的最大条数
    - name: translate
      type: string[]
      desc: 翻译字段，若返回数据存在instanceId，则在cmdb取相应字段的值填充进返回数据。
    - name: transform
      type: object
      desc: 转换规则，类似 excel 透视表行和列的转换， 详情见 https://tapd.easyops.local/pages/viewpage.action?pageId=25277283
    - name: epoch
      type: string
      desc: 返回时间单位
    - name: limitBy
      type: LimitBy
      desc: 按字段分组，指定每组返回最大条数
    - name: having
      type: Having[]
      desc: having过滤
    - name: countTotal
      type: bool
      desc: 是否查询真实total(为false时置为返回list的长度)
    - name: withEmptyData
      type: bool
      desc: 是否查询时序数据为空时的实例数据(只在model为cmdb时才生效)
    - name: withAlertRule
      type: bool
      desc: 是否查询实例所属告警规则
    - name: displayName
      type: bool
      desc: 是否显示别名
    - name: fillEmptyData
      type: bool
      desc: 是否填充空数据
    - name: withCurrentAlert
      type: bool
      desc: 查询当前指标是否告警
  response:
    fields:
    - name: total
      type: int
      desc: 总数
    - name: list
      type: map[]
      desc: 统计后的数据
    - name: from
      type: int64
      desc: 起始时间戳,仅聚合维度包含time(xx)才有值
    - name: to
      type: int64
      desc: 终止时间戳,仅聚合维度包含time(xx)才有值
    - name: step
      type: int
      desc: 时间间隔,仅聚合维度包含time(xx)才有值
    - name: alert_thresholds
      type: AlertThreshold[]
      desc: 请求指定指标包含的告警策略
    - name: currentAlerts
      type: CurrentAlert[]
      desc: 当前指标是否告警的数据列表
    - name: displayNameList
      type: DisplayName[]
      desc: 指标和纬度别名数据
  semantic_gaps: []
  port: 8140
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
