- operation_key: logic.data_exchange|POST|/api/v1/data_exchange/tsdb_column/aggregate
  method: POST
  path: /api/v1/data_exchange/tsdb_column/aggregate
  raw_paths:
    backend: /api/v1/data_exchange/tsdb_column/aggregate
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.data_exchange
  request:
    fields:
    - name: database
      type: string
      desc: org
    - name: object_ids
      type: string[]
      desc: 列存储模型名
    - name: filed
      type: string[]
      desc: 拼写错误废弃字段，与field一致，同时传入则使用此字段。
    - name: fields
      type: string[]
      desc: 返回属性列表；字符串数组；只返回需要的数据，需要返回所有字段时，带上 *
    - name: filter
      type: map
      desc: 过滤条件；Struct；与easy_core的查询filter基本一致
    - name: start_time
      type: int64
      desc: 查询的开始时间，单位毫秒；整型；包括当前时间点
    - name: end_time
      type: int64
      desc: 查询的结束时间，单位毫秒；整型；不包括当前时间点
    - name: page
      type: int64
      desc: 分页page
    - name: page_size
      type: int64
      desc: 分页page_size
    - name: having
      type: map
      desc: 对聚合后的数据进行过滤；Struct类型；与easy_core的查询filter基本一致
    - name: group_by
      type: string[]
      desc: 分组属性
    - name: sorts
      type: ColumnSort[]
      desc: ColumnSort类型，可以参考tsdb column_object.ColumnSort的定义；暂时不要传值，性能有问题
    - name: measures
      type: object[]
      desc: 和 fields一起返回数据，名字会覆盖fields的值；UserFunc类型数组
    - name: only_tmp_data
      type: bool
      desc: 只返回临时数据
  response:
    fields:
    - name: code
      type: int
      desc: 响应码
    - name: message
      type: string
      desc: 响应消息
    - name: page
      type: int64
      desc: 当前页
    - name: page_size
      type: int64
      desc: 页数大小
    - name: total
      type: int64
      desc: 数据总数
    - name: data
      type: map[]
      desc: 返回的数据
  semantic_gaps: []
  port: 8152
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
