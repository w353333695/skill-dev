- operation_key: logic.cmdb.service|POST|/relation/{relation_id}/instance/_search
  method: POST
  path: /relation/{relation_id}/instance/_search
  raw_paths:
    backend: /relation/:relation_id/instance/_search
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb.service
  request:
    fields:
    - name: relation_id
      type: string
      desc: 关系对象ID
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: fields
      type: string[]
      desc: '指定返回字段(支持通过父模型指定子模型属性)(支持关系数据的二级jsonPath格式的指定字段如clusters.name), e.g.:
        [name, instanceId]'
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: sort
      type: object[]
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: [{ key:
        instanceId, order: 1}]'
    - name: ignore_missing_field_error
      type: bool
      desc: 是否忽略fields有不存在的字段的报错
    - name: with_empty_edge_instance
      type: bool
      desc: 是否返回边属性为空的关系
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
