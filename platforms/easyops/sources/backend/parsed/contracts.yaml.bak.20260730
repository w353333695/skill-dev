- operation_key: logic.flowable_service|POST|/api/flowable_service/v1/instance/{objectId}/_search
  method: POST
  path: /api/flowable_service/v1/instance/{objectId}/_search
  raw_paths:
    backend: /api/flowable_service/v1/instance/:objectId/_search
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.flowable_service
  request:
    fields:
    - name: objectId
      type: object_id
      desc: 模型对象ID
    - name: url
      type: string
      desc: '指定要访问的cmdb主机：e.g: http://192.168.100.139'
    - name: org
      type: int
      desc: 目标机器的org
    - name: user
      type: string
      desc: 访问用户
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: query_context
      type: map
      desc: '查询条件模板上下文 模板格式为 @{key} ,e.g.: query:{ name: { $like: ''%@{key1}%''},
        int: ''@{key2}'' }, query_context:{ key1: ''val1'', ''key2'': 12 }, query则会被转换成{
        name: { $like: ''%val1%'' }, int: 12 }, 如果key1对应的值为null或者空字符串, query则会被转换成{
        int: 12 }'
    - name: fields
      type: string[]
      desc: '指定返回字段(支持通过父模型指定子模型属性)(支持关系数据的二级jsonPath格式的指定字段如clusters.name), e.g.:
        [name, instanceId]'
    - name: only_my_instance
      type: bool
      desc: 当为 true 时，只搜索与我相关实例
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: sort
      type: object[]
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: [{ key:
        instanceId, order: 1}]'
    - name: permission
      type: string[]
      desc: '按照权限过滤(通用实例都有 read， update， delete 权限控制， 主机实例在通用实例权限基础上有额外的 operate 权限，
        应用实例在通用实例权限基础上有额外的 developClusterOperate， testClusterOperate， prereleaseClusterOperate，
        productionClusterOperate 权限) e.g.: [ "operate", "update" ]'
    - name: relation_limit
      type: int
      desc: 限制fields所带出的关系的数量， 0为不限制，全局配置
    - name: limitations
      type: object[]
      desc: 单独指定关系的limit与sort
    - name: ignore_missing_field_error
      type: bool
      desc: 是否忽略fields有不存在的字段的报错
    - name: metrics_filter
      type: object
      desc: 指标数据查询
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: 8134
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
- operation_key: logic.flowable_service|POST|/api/flowable_service/v1/knowledge_base/bulk/delete/knowledge
