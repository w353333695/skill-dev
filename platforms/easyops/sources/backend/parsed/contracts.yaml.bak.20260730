- operation_key: logic.tool_service|GET|/tools
  method: GET
  path: /tools
  raw_paths:
    backend: /tools
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.tool_service
  request:
    fields:
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 页大小
    - name: detail
      type: bool
      desc: 是否显示具体信息
    - name: plugin
      type: bool
      desc: 是否显示插件
    - name: toolId
      type: string
      desc: toolIds，用","分隔
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: 工具脚本的类型(python, shell..)
    - name: category
      type: string
      desc: 工具的分类
    - name: permissions
      type: string
      desc: 用户对工具具有的权限; 用","分割(read=查看, update=更新, delete=删除, execute=执行, execResult=执行结果查看,
        rootExec=Root执行)
    - name: onlyProduction
      type: bool
      desc: 仅选择有生产版本的工具 true | false. 默认是false
    - name: showInvisible
      type: bool
      desc: 显示listVisible=false的工具; true=显示 | false=不显示. 默认是false
    - name: viewWhitelist
      type: bool
      desc: 是否返回白名单信息 默认是false
    - name: tags
      type: string
      desc: 标签，用","分隔，标签只支持字符串
    - name: fields
      type: string
      desc: '指定查询字段,逗号隔开,eg: "fields=toolId,name"，支持如下字段

        "toolId", "name", "creator", "category", "icon", "style", "disable", "tags",
        "vId",

        "vName", "type", "functionType", "checkInfo", "envType", "memo"

        '
    - name: execPreAuthOnly
      type: bool
      desc: 只查询执行前校验的流程
    - name: creatorOnly
      type: bool
      desc: 只查询由当前用户创建的工具（即creator是当前用户的工具）
    - name: needMyApprovalOnly
      type: bool
      desc: 只查询待我审批的工具（若工具状态为待审批，且未指定审批用户，则也在返回列表中）
    - name: null
      type: ''
      desc: 产品类型过滤，空值或不传返回运维自动化工具，"env_check"返回运行环境检查工具
  response:
    fields:
    - name: list
      type: Tool[]
      desc: 工具列表
    - name: plugins
      type: Tool[]
      desc: 插件列表
    - name: total
      type: int
      desc: 总数
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: 8181
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
