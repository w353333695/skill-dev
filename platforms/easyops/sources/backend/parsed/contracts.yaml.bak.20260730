- operation_key: logic.artifact|POST|/workspace/{packageId}/upload
  method: POST
  path: /workspace/{packageId}/upload
  raw_paths:
    backend: /workspace/:packageId/upload
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.artifact
  request:
    fields:
    - name: null
      type: ''
      desc: ''
    - name: path
      type: file_path
      desc: 上传时path是指存储的目录
    - name: encoding
      type: string
      desc: 参数path的编码格式
    - name: filenameEncoding
      type: string
      desc: 解压文件的编码参数
    - name: fileId
      type: string
      desc: 文件Id用于判断是否重新解压该文件
    - name: file
      type: file
      desc: 上传的文件内容
    - name: decompress
      type: pseudo_bool
      desc: 上传文件是否要解压(true,false)
    - name: strip
      type: pseudo_bool
      desc: 解压文件是否要忽略顶层目录(true,false)
    - name: workspaceBaseId
      type: string
      desc: 工作区基线版本, 此参数如果传入且与真正的基线版本不一致时将报错
    - name: ignoreCase
      type: bool
      desc: 是否忽略同级目录下大小写重名文件，为true则保留重名文件，为false则删除重名文件只保留最新上传的文件(只处理Windows平台制品)
  response:
    fields:
    - name: code
      type: int
      desc: 返回状态码
    - name: error
