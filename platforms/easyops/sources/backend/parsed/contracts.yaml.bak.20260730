- operation_key: logic.flowable_service|POST|/api/flowable_service/v1/process_instance_step
  method: POST
  path: /api/flowable_service/v1/process_instance_step
  raw_paths:
    backend: /api/flowable_service/v1/process_instance_step
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.flowable_service
  request:
    fields:
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 每页数据量
    - name: Q
      type: string
      desc: 模糊搜索，匹配taskname(任务名称), instanceName(工单名称),status(任务状态) orderNum(工单号),category(流程分类),
        assignee(指派人)
    - name: name
      type: string
      desc: 任务名称
    - name: processName
      type: string
      desc: 流程实例(工单)名称
    - name: status
      type: string
      desc: 流程任务状态
    - name: orderNum
      type: string
      desc: 流程实例(工单)编号
    - name: processStatus
      type: string
      desc: 流程实例(工单)状态
    - name: creator
      type: string
      desc: 发起人(工单创建人)
    - name: category
      type: string
      desc: 流程分类
    - name: tag
      type: string
      desc: 分类标签(run待办(待审批/待分配)、cc待阅, done已完成, mine我的工单, claim待认领,unhandled未指定处理人)
    - name: isShowSub
      type: bool
      desc: 是否展示子流程任务(默认不展示)
    - name: isDelete
      type: bool
      desc: 是否已被删除
    - name: handleWay
      type: string
      desc: 工单处理方式(common-普通处理,priority-优先处理,emergency-紧急处理),默认common
    - name: serviceCategory
      type: string
      desc: 流程服务类型(change:变更,event:事件,req:请求,question:问题,release:发布,config:配置)
    - name: serviceId
      type: string
      desc: 服务实例id
    - name: st
      type: datetime
      desc: 开始时间
    - name: et
      type: datetime
      desc: 结束时间
    - name: filter
      type: object
      desc: 过滤器查询条件
  response:
    fields:
    - name: list
      type: object[]
      desc: 工单任务列表
    - name: total
      type: int
      desc: 列表总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: 8134
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
