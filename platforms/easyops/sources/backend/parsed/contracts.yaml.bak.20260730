- operation_key: logic.tuna_service|POST|/api/v1/tuna_service/performance/tests
  method: POST
  path: /api/v1/tuna_service/performance/tests
  raw_paths:
    backend: /api/v1/tuna_service/performance/tests
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.tuna_service
  request:
    fields:
    - name: fields
      type: string[]
      desc: 'e.g.: [instanceId, name, owner.name]， *代表所有普通属性， 注意：建议都指定fields，按需拉取字段，不然有可能返回数据量太大而导致接口慢系统不稳定'
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: sort
      type: object[]
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: [{ key:
        instanceId, order: 1}]'
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
