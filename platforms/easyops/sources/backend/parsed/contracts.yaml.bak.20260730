- operation_key: logic.llm.aiops_service|POST|/api/v1/llm/tools/template_llm_chat_v2
  method: POST
  path: /api/v1/llm/tools/template_llm_chat_v2
  raw_paths:
    backend: /api/v1/llm/tools/template_llm_chat_v2
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.llm.aiops_service
  request:
    fields:
    - name: template
      type: string
      desc: 模板，为空时，不使用默认引擎
    - name: variables
      type: map
      desc: 模板引擎的数据
    - name: model
      type: string
      desc: 大模型id
    - name: historyMessages
      type: LLMChatMessage[]
      desc: 历史对话消息
    - name: input
      type: string
      desc: 输入对话,模板为空时才生效
    - name: outputType
      type: string
      desc: 输出格式，默认json
    - name: temperature
      type: float
      desc: 取值范围是：(0.0, 1.0]，不能等于 0，默认值为 0.1，值越大，会使输出更随机，更具创造性；值越小，输出会更加稳定或确定
    - name: debug
      type: bool
      desc: 是否是调试模式，为true时，返回debug_resp
    - name: stream
      type: bool
      desc: 是否是流式
    - name: systemTemplate
      type: string
      desc: system角色的提示词模板
    - name: systemVariables
      type: map
      desc: system模板所需要的数据
    - name: taskId
      type: string
      desc: 任务id
    - name: images
      type: string[]
      desc: 输入的图片url
    - name: maxTokens
      type: int
      desc: 请求最大 token 数
    - name: extendMeta
      type: map
      desc: 拓展的元数据字段，其中：elevoConversationId，不为空时，会记录elevo的会话日志
    - name: seed
      type: int
      desc: 请求大模型的seed, 不传为默认
  response:
    fields:
    - name: null
      type: ''
      desc: ''
    - name: data
      type: value
      desc: 提取返回的数据
    - name: reasoning_content
      type: string
      desc: 推理模型的推理内容
    - name: debug_resp
      type: string
      desc: 调试时大模型返回值
    - name: errorOutput
      type: string
      desc: 如果解析不到正确的数据格式，则将大模型返回的数据塞到这里
  semantic_gaps: []
  port: 8320
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
