- operation_key: logic.alert_service|POST|/api/v1/monitor_event/not_recover/_search
  method: POST
  path: /api/v1/monitor_event/not_recover/_search
  raw_paths:
    backend: /api/v1/monitor_event/not_recover/_search
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.alert_service
  request:
    fields:
    - name: fields
      type: string[]
      desc: 选择返回的字段,不传则返回所有字段
    - name: sort
      type: string
      desc: 排序
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 分页大小
    - name: parentObjects
      type: string[]
      desc: 父模型, 若选取的监控资源仅为父模型，则传参; 若选取的监控资源为子模型, 则传空
    - name: query
      type: map
      desc: 搜索条件,与mongo语法一致
    - name: st
      type: string
      desc: '开始时间, e.g.: -1h 过去1小时, -1d 过去1天, -30m 过去30分钟, 1490967693 unix 时间戳'
    - name: et
      type: string
      desc: '结束时间, e.g.: -1h 过去1小时, -1d 过去1天, -30m 过去30分钟, 1490967693 unix 时间戳'
    - name: displayNameEnabled
      type: bool
      desc: 是否返回别名
    - name: withCurrentStepUsers
      type: bool
      desc: 是否返回当前步骤处理人
    - name: onlyNotifyMyself
      type: bool
      desc: 最终通知人为我
    - name: hasOrder
      type: bool
      desc: 已转单的事件
    - name: responsibleSystemOnly
      type: bool
      desc: 告警资源所属系统是否由我负责。如果为false，全部事件；为true，我负责的系统下所有资源的告警事件
  response:
