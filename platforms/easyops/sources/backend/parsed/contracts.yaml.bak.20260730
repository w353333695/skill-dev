  raw_paths:
    backend: /api/flowable_service/v2/process_instance_count
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.flowable_service
  request:
    fields:
    - name: tags
      type: string
      desc: '要查询的tag, 用“,”分割 Total 所有工单 mine 我发起的工单 run 我的待办任务 emergency 我的待办紧急任务
        cc 待阅 done 已完成任务 unhandled 未分配的任务 waitComment 待评论的工单 supervision 督办工单 oRunning
        流转中的工单 oDone 已完成的工单 mDone 我完成过其中任务的工单 claim 待认领工单数 suspend 已挂起任务数 '
    - name: st
      type: datetime
      desc: 开始时间
    - name: et
      type: datetime
      desc: 结束时间
  response:
    fields:
    - name: list
      type: object[]
      desc: 结果列表
  semantic_gaps: []
  port: 8134
