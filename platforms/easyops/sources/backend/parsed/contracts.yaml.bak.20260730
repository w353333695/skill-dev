    - name: dst_object_id
      type: object_id
      desc: 路径结束资源模型ID
    - name: max_depth
      type: int
      desc: 搜索路径最大深度
    - name: max_sub_node
      type: int
      desc: 搜索最大模型数
    - name: with_cycle
      type: bool
      desc: 是否带环搜索，默认false
    - name: white_list
      type: string
      desc: 必须按序经过的模型，多个以分号分隔， 如APP;HOST
    - name: black_list
      type: string
      desc: 屏蔽的模型，多个以分号分隔， 如APP;HOST
    - name: show_inherit_node
      type: bool
      desc: 若节点关联抽象关系，是否展示关联的子模型节点
    - name: path_ids
      type: string
