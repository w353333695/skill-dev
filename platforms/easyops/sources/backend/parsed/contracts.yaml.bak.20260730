  raw_paths:
    backend: /api/v1/signin/:protocol
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.sso_adapter
  request:
    fields:
    - name: protocol
      type: string
      desc: 身份认证协议类型, 如OAuth2、cas等
    - name: query
      type: map
      desc: HTTP GET query api_gateway 请求时一定包含字段 clientIp, 表示用户浏览器的 ip 字段 host，表示访问域名，用于多域名情况
  response:
    fields:
    - name: loginKey
      type: string
      desc: 登录的key字符串, 例如SSO登录时候的工号的key
    - name: loginValue
      type: string
      desc: 登录的值, 例如SSO登录时候的工号的值
    - name: easyopsRedirect
      type: string
      desc: easyops平台的回调地址，用于重定向到easyops平台的页面
    - name: authorizationInfo
      type: map
      desc: OA的访问凭证信息, 将会作为一段序列返回到api_gateway中, 与登录态信息一起保存
