      type: map
      desc: 搜索条件,与mongo语法一致
    - name: st
      type: string
      desc: '开始时间, e.g.: -1h 过去1小时, -1d 过去1天, -30m 过去30分钟, 1490967693 unix 时间戳'
    - name: et
      type: string
      desc: '结束时间, e.g.: -1h 过去1小时, -1d 过去1天, -30m 过去30分钟, 1490967693 unix 时间戳'
