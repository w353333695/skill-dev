      type: string
      desc: 接口名称
    - name: code
      type: int
      desc: 状态
    - name: duration
      type: int
      desc: 耗时
    - name: attributeKey
      type: string
      desc: 属性名称
    - name: attributeValue
      type: string
      desc: 属性值
