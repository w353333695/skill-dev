- operation_key: logic.data_exchange|POST|/api/v2/data_exchange/olap
  method: POST
  path: /api/v2/data_exchange/olap
  raw_paths:
    backend: /api/v2/data_exchange/olap
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.data_exchange
  request:
    fields:
    - name: model
      type: string
      desc: '1. dataSource 为 cmdb 时， model 为 "cmdb.model"

        2. dataSource 为 clickhouse 时， model 为 "库名.表名"

        '
    - name: query
      type: map
      desc: CMDB 过滤条件
    - name: dims
      type: string[]
      desc: 聚合的维度
    - name: cmdbGroupDims
      type: string[]
      desc: 根据 cmdb 关系/属性汇聚，例如：relatedHost.hostname（按所属主机汇聚）
    - name: measures
      type: Measure[]
      desc: 指标聚合计算规则
    - name: filters
      type: Filter[]
      desc: 过滤条件
    - name: order
      type: Order[]
      desc: 指定字段排序, 数组是有顺序，哪个字段在前，先按哪个字段排序
    - name: limit
      type: Limit
      desc: 指定获取数据的最大条数
    - name: translate
      type: string[]
      desc: 翻译字段，若返回数据存在instanceId，则在cmdb取相应字段的值填充进返回数据。
    - name: transform
      type: object
      desc: 转换规则，类似 excel 透视表行和列的转换， 详情见 https://tapd.easyops.local/pages/viewpage.action?pageId=25277283
    - name: epoch
      type: string
      desc: 返回时间单位
    - name: limitBy
      type: LimitBy
      desc: 按字段分组，指定每组返回最大条数
    - name: having
      type: Having[]
      desc: having过滤
    - name: countTotal
      type: bool
      desc: 是否查询真实total(为false时置为返回list的长度)
    - name: withEmptyData
      type: bool
      desc: 是否查询时序数据为空时的实例数据(只在model为cmdb时才生效)
    - name: withAlertRule
      type: bool
      desc: 是否查询实例所属告警规则
    - name: displayName
      type: bool
      desc: 是否显示别名
    - name: fillEmptyData
      type: bool
      desc: 是否填充空数据
    - name: minimumStep
      type: string
      desc: 最小步长，仅聚合维度time为auto时才生效
    - name: withoutObjectId
      type: bool
      desc: 是否返回 _object_id 字段,默认返回 _object_id
    - name: withShowKey
      type: bool
      desc: 是否返回cmdb实例showKey
    - name: resolutionOffset
      type: int64
      desc: 汇聚时相对于UTC偏移量，单位ms。比如需要按照本地时间偏移：8 * 3600 * 1000（加8小时），如果需要按照start_time偏移，可以设置为start_time
    - name: fieldsRelationFilter
      type: map
      desc: '为 key -> filter, 其中key必须为关系（支持多层）或者边属性@结尾，filter语法同上面的实例filter。 如: APP
        <-cluster---app-> CLUSTER <-host---cluster-> HOST 中 支持： {"cluster": {"$or":[{"name":"aaa"},{"ip":"1"}]},"cluster.@":{"name":"aaa","ctime":"xxx"},"cluster.host":{...}}
        上面过滤，则获取的数据只包含cluster名字为aaa或者ip为1 的 同时边属性满足上面的条件的（目前边属性仅支持 and 逻辑，不支持 or 逻辑），cluster.host同理。
        不支持：{"cluster.name":"aaa"}，key只能为关系的out_id 或者 多层out_id，最后一层支持.@表示该关系上的边属性。'
  response:
    fields:
    - name: total
      type: int
      desc: 总数
    - name: list
      type: map[]
      desc: 统计后的数据
    - name: from
      type: int64
      desc: 起始时间戳,仅聚合维度包含time(xx)才有值
    - name: to
      type: int64
      desc: 终止时间戳,仅聚合维度包含time(xx)才有值
    - name: step
      type: int
      desc: 时间间隔,仅聚合维度包含time(xx)才有值
    - name: alert_thresholds
      type: AlertThreshold[]
      desc: 请求指定指标包含的告警策略
    - name: displayNameList
      type: DisplayName[]
      desc: 指标和纬度别名数据
  semantic_gaps: []
  port: 8152
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
