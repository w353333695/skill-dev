- operation_key: logic.app_deploy_service|POST|/api/app_deploy_service/v1/container_namespaces
  method: POST
  path: /api/app_deploy_service/v1/container_namespaces
  raw_paths:
    backend: /api/app_deploy_service/v1/container_namespaces
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.app_deploy_service
  request:
    fields:
    - name: clusterId
      type: instance_id
      desc: k8s 集群 id
    - name: namespace
      type: Namespace
      desc: 命名空间
    - name: namespaceQuota
      type: map
      desc: "namespace 资源限制\n{\n  \"count/deployments.apps\": \"100\",   #  无状态工作负载\n\
        \  \"count/statefulsets.apps\": \"100\",  #  有状态工作负载\n  \"count/daemonsets.apps\"\
        : \"100\",    #  守护进程\n  \"count/jobs.batch\": \"100\",     # 任务\n  \"count/cronjobs.batch\"\
        : \"100\", # 定时任务\n  \"count/pods\": \"500\",      # Pod\n  \"count/services\"\
        : \"100\",  # 服务\n  \"count/ingresses.extensions\": \"100\", # 应用路由\n  \"\
        persistentvolumeclaims\": \"100\", # 存储卷\n  \"count/secrets\": \"100\",  \
        \  # 密钥\n  \"count/configmaps\": \"100\", # 配置\n  \"limits.cpu\": \"10\",\
        \        # CPU 限额\n  \"limits.memory\": \"20Gi\"    # 内存限额\n  \"requests.cpu\"\
        : \"1\",       # CPU 预留\n  \"requests.memory\": \"100Mi\" # 内存预留\n}\n"
    - name: containerDefaultLimit
      type: ResourceRequirements
      desc: 最大资源限制和初始资源请求
  response:
    fields:
    - name: namespace
      type: Namespace
      desc: 命名空间
    - name: namespaceQuota
      type: ResourceQuota
      desc: 资源限制
    - name: containerDefaultLimit
      type: ResourceRequirements
      desc: 最大资源限制和初始资源请求
  semantic_gaps: []
  port: 8270
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
