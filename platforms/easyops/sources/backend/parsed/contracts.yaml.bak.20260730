  request:
    fields:
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: fields
      type: string[]
      desc: '指定返回字段, e.g.: [name, instanceId]'
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: sort
      type: map
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: { instanceId:
        1 }'
    - name: type
      type: string
      desc: 任务类型，backlog-待办，done-已办，all-全部
    - name: year
      type: string
      desc: 需求提出日期：年份
    - name: department
      type: string[]
      desc: 业务部门：需求提出部门
    - name: secondaryDepartment
      type: string[]
      desc: 二级部门：需求产品线对应的二级部门
    - name: productLine
      type: string[]
      desc: 产品线：需求产品线
