- operation_key: logic.console_gateway|POST|/api/cmdb_resource/object/{objectId}/instance/_search/all
  method: POST
  path: /api/cmdb_resource/object/{objectId}/instance/_search/all
  raw_paths:
    backend: /api/cmdb_resource/object/:objectId/instance/_search/all
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.console_gateway
  request:
    fields:
    - name: objectId
      type: object_id
      desc: 模型对象ID
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: fields
      type: map
      desc: 'e.g.: { instanceId: true, name: true }'
    - name: only_my_instance
      type: bool
      desc: 当为 true 时，只搜索与我相关实例
    - name: only_relation_view
      type: bool
      desc: 对于关联的实例数据是否只获取 relation_view 中指定的属性, 这个字段为 true 时, 会覆盖 fields 字段中指定的二级字段设置
    - name: sort
      type: map
      desc: '按字段排序, 留空默认按照实例ID降序排序(1表示升序, -1表示降序) e.g.: { instanceId: 1 }'
    - name: permission
      type: string[]
      desc: '按照权限过滤(通用实例都有 read, update, delete 权限控制, 主机实例在通用实例权限基础上有额外的 operate 权限,
        应用实例在通用实例权限基础上有额外的 developClusterOperate, testClusterOperate, prereleaseClusterOperate,
        productionClusterOperate 权限) e.g.: [ "operate", "update" ]'
  response:
    fields:
    - name: code
      type: int
      desc: 返回码
    - name: error
      type: string
      desc: 错误信息
    - name: message
      type: string
      desc: 返回消息
    - name: data
      type: map[]
      desc: 实例列表
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
