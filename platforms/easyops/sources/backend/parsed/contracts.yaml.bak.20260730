    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 分页大小
    - name: total
      type: int
      desc: 总数
    - name: list
      type: object[]
      desc: 告警事件列表
  semantic_gaps: []
  port: 8131
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
