  method: LIST
  path: /api/v1/collector-metric-names
  raw_paths:
    backend: /api/v1/collector-metric-names
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.collector_service
  request:
    fields:
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 每页大小
    - name: objectId
      type: string
      desc: 目标模型ID，多个使用逗号分隔
    - name: metricName
      type: string
      desc: 搜索指标名,模糊匹配
    - name: metricNames
      type: comma_separated_string
      desc: 指标名列表,多个使用逗号分隔(完全匹配)
    - name: jobId
      type: instance_id
      desc: 采集任务Id
    - name: onlyBasicInfo
      type: bool
      desc: 只获取基本信息（不包含关联模版列表，关联告警策略数量, 关联资源信息）,默认获取全部信息
    - name: onlyKeyMetric
      type: bool
      desc: 只获取关键指标
    - name: types
      type: comma_separated_string
      desc: 筛选的指标类型列表,多个使用逗号分隔(完全匹配)
    - name: showAlert
