- operation_key: logic.flowable_service|POST|/api/flowable_service/v1/process_filter_statistics
  method: POST
  path: /api/flowable_service/v1/process_filter_statistics
  raw_paths:
    backend: /api/flowable_service/v1/process_filter_statistics
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.flowable_service
  request:
    fields:
    - name: Q
      type: string
      desc: 模糊搜索，匹配name工单名称, status工单状态, service服务名称, form表单信息, 处理人等
    - name: status
      type: string
      desc: 流程实例状态
    - name: name
      type: string
      desc: 流程实例(工单)名称
    - name: orderNum
      type: string
      desc: 流程实例(工单)编号
    - name: isDelete
      type: bool
      desc: 是否已被删除
    - name: serviceCategory
      type: string
      desc: 流程服务类型(change:变更,event:事件,req:请求,question:问题,release:发布,config:配置)
    - name: serviceId
      type: string
      desc: 服务实例id
    - name: category
      type: string
      desc: 流程分类
    - name: processName
      type: string
      desc: 流程名称
    - name: processStepName
      type: string
      desc: 任务名称(流程步骤名称)
    - name: creator
      type: string
      desc: 发起人(工单创建人)
    - name: tag
      type: string
      desc: 分类标签(run待办、cc待阅, done已完成, mine我的工单, claim待认领, distribution待分配, supervision督办)
    - name: isShowSub
      type: bool
      desc: 是否展示子流程(默认不展示)
    - name: st
      type: datetime
      desc: 开始时间
    - name: et
      type: datetime
      desc: 结束时间
    - name: handleWay
      type: string
      desc: 工单处理方式(common-普通处理,priority-优先处理,emergency-紧急处理),默认common
    - name: slaStatus
      type: string
      desc: 工单 sla 状态(warning-预警,timeout-超时)
    - name: source
      type: string
      desc: 工单来源
    - name: filter
      type: object
      desc: 过滤器查询条件
  response:
    fields:
    - name: statusStatistical
      type: object[]
      desc: 工单状态统计
    - name: serviceCategoryStatistical
      type: object[]
      desc: 服务分类统计
    - name: serviceStatistical
      type: object[]
      desc: 工单数（服务名称）占比
    - name: slaStatusStatistical
      type: object[]
      desc: 工单运行状态占比
    - name: momentStatistical
      type: object[]
