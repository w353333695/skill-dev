- operation_key: logic.custom_demand_manager|POST|/api/v1/task_manager/taskManager/list
  method: POST
  path: /api/v1/task_manager/taskManager/list
  raw_paths:
    backend: /api/v1/task_manager/taskManager/list
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.custom_demand_manager
  request:
    fields:
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: fields
      type: string[]
      desc: '指定返回字段, e.g.: [name, instanceId]'
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: sort
      type: map
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: { instanceId:
        1 }'
    - name: onlyMyInstance
      type: bool
      desc: 是否只查询与我相关的数据
    - name: taskPhase
      type: string
      desc: 任务阶段：实施中、反馈中、异常
    - name: taskStatusGroup
      type: string
      desc: 任务状态组：实施中、组版测试阶段、开发阶段、异常研发任务、SIT测试阶段、研发计划评估阶段、等待开发阶段
    - name: taskSchedule
      type: string
      desc: 任务排期：待确认、大于90天、90天以内、60天以内、30天以内、计划评估中
    - name: startDate
      type: string
      desc: '开始日期, eg: 2022-11'
    - name: endDate
      type: string
      desc: '结束日期, eg: 2022-12'
    - name: reqType
      type: string[]
      desc: 需求类型：数据需求; 优化需求; 缺陷修复
    - name: secondaryDepartment
      type: string[]
      desc: 二级部门：任务产品线对应的二级部门
    - name: productLine
      type: string[]
      desc: 产品线：任务产品线
    - name: taskType
      type: string
      desc: 任务类型（驾驶舱跳转时使用）,created:新增，online：在线，impl：实施中
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
