      type: string
      desc: 权限点
    - name: resource
      type: string
      desc: 校验对象
    - name: resourceIds
      type: string[]
      desc: 校验数据id
    - name: resourceKey
      type: string
      desc: resourceId查询的key值，不设置则为instanceId
    - name: onlyFilter
      type: bool
      desc: 只返回filter, 不对校验对象进行校验，用于业务方获取规则filter，筛选查询条件
