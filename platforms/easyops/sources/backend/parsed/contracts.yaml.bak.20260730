- operation_key: logic.cmdb.service|POST|/v2/object/{object_id}/instance/group
  method: POST
  path: /v2/object/{object_id}/instance/group
  raw_paths:
    backend: /v2/object/:object_id/instance/group
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb.service
  request:
    fields:
    - name: object_id
      type: object_id
      desc: URL中资源模型ID
    - name: query
      type: map
      desc: 查询条件,与[实例搜索接口]的query字段说明一致
    - name: permission
      type: string[]
      desc: 按照权限过滤(通用实例都有`read`, `update`, `delete`权限控制, 主机实例在通用实例权限基础上有额外的`operate`权限,
        应用实例在通用实例权限基础上有额外的`developClusterOperate`, `testClusterOperate`, `prereleaseClusterOperate`,
        `productionClusterOperate`权限)
    - name: only_my_instance
      type: bool
      desc: 是否只获取与自己有关的那部分数据, 默认为false
    - name: group_field
      type: string
      desc: 聚合属性id（只支持普通属性）
    - name: funcs
      type: GroupInstanceFunc[]
      desc: 操作列表,对某字段进行,sum, max...
    - name: filter_relation
      type: bool
      desc: 结果是否仅返回上面filter匹配上的对端关系，默认false返回全部对端关系。
  response:
    fields:
    - name: list
      type: map[]
      desc: 数据列表，将group_field和funcs.alias的值作为key，group_value和funcs.value的值作为value
    - name: total
      type: int
      desc: total
  semantic_gaps: []
  port: 8079
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
