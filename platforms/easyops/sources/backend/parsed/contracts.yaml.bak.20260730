- operation_key: logic.topboard|POST|/api/topboard/v1/idea/_search
  method: POST
  path: /api/topboard/v1/idea/_search
  raw_paths:
    backend: /api/topboard/v1/idea/_search
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.topboard
  request:
    fields:
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: sort
      type: SearchSort[]
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: [{ key:
        instanceId, order: 1}]'
    - name: page
      type: int
      desc: 页码
    - name: pageSize
      type: int
      desc: 页容量
    - name: producer
      type: user_name
      desc: 产品经理名称, 关系字段, producer.name
    - name: solution
      type: string
      desc: 产品线名, 关系字段, product_line.name
    - name: deliveryProjectName
      type: string
      desc: 交付项目, 关系字段, deliveryProject.name
    - name: issueFrom
      type: string
      desc: 客户, 关系字段, customer.name
    - name: reporter
      type: user_name
      desc: 提出人, 关系字段, PROPOSER.name
    - name: pmoUser
      type: user_name
      desc: PMO负责人, 关系字段, PMO.name
    - name: relevantToMe
      type: bool
      desc: 与我有关
    - name: hasPd
      type: bool
      desc: 产品经理, false-不处理, true-producer.name 不为空
    - name: tag
      type: string
      desc: 待规划分类, eg.专项-objective 结项-toClosing 运营-operation 其他-other
    - name: ctimeByMonth
      type: string
      desc: 创建时间按月筛选
    - name: endDateByMonth
      type: string
      desc: 按结束月份筛选
    - name: ranking
      type: string
      desc: 排名规则,全局排行按照产品线进行排名
    - name: objective
      type: string
      desc: 专项
    - name: customerConfirm
      type: int
      desc: 验收情况, eg.未通过 -1, 未确认0, 通过1
    - name: category
      type: string[]
      desc: 想法类型
    - name: XXX_RestFieldMask
      type: string[]
      desc: sdk限制字段, 将需要限制的字段写入当中, 如果该字段的值为空, 序列化时将不会设置这个字段
  response:
    fields:
    - name: list
      type: Idea[]
      desc: 想法列表
    - name: categoryCnt
      type: object[]
      desc: 各类型数目
    - name: total
      type: int
      desc: 总数
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
