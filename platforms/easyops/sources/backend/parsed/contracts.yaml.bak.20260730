- operation_key: logic.tool|LIST|/flows
  method: LIST
  path: /flows
  raw_paths:
    backend: /flows
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.tool
  request:
    fields:
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: null
      type: ''
      desc: ''
    - name: page
      type: page
      desc: 查询页面
    - name: exactType
      type: bool
      desc: 准确匹配type,默认为false模糊匹配
    - name: pageSize
      type: page_size
      desc: 每页数量
    - name: keyword
      type: string
      desc: 名字模糊匹配
    - name: notCategory
      type: bool
      desc: 没设类别的流程
    - name: permissions
      type: string
      desc: 用户对流程具有的权限; 用","分割(read=查看, update=更新, delete=删除, execute=执行)
    - name: metadataKey
      type: string
      desc: 元数据查询的key名称(支持对流程metadata属性数据的查询，如 metadata.customKey(MongoDB二级查询语法))
    - name: metadataValue
      type: string
      desc: 元数据查询的key对应的值; 目前只支持字符串。(在实际查询时是metadata.customValue)
    - name: ids
      type: string
      desc: 指定返回流程id，用","分隔
    - name: XXX_RestFieldMask
      type: string[]
      desc: sdk限制字段, 将需要限制的字段写入当中, 如果该字段的值为空, 序列化时将不会设置这个字段
    - name: withBaseInfo
      type: bool
      desc: 是否只获取基础字段，false则获取所有字段，true则获取基础字段，包括createTime,creator,flowId,name,updateTime,type,metadata,vName,vCreator,version
    - name: extraFields
      type: string
      desc: 获取扩展字段，用","分隔，仅当withBaseInfo为true才有效
    - name: publishedOnly
      type: bool
      desc: 只查询已发布的流程
    - name: execPreAuthOnly
      type: bool
      desc: 只查询执行前校验的流程
    - name: productionOnly
      type: bool
      desc: 仅选择有生产版本的流程 true | false. 默认是 false
    - name: needMyApprovalOnly
      type: bool
      desc: 只查询待我审批的流程（若流程状态为待审批，且未指定审批用户，则也在返回列表中）
  response:
    fields: []
  semantic_gaps: []
  port: 8181
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
