    - name: fields
      type: string[]
      desc: 返回属性列表；字符串数组；只返回需要的数据，需要返回所有字段时，带上 *
    - name: filter
      type: map
      desc: 过滤条件；Struct；与easy_core的查询filter基本一致
    - name: start_time
      type: int64
      desc: 查询的开始时间，单位毫秒；整型；包括当前时间点
    - name: end_time
      type: int64
      desc: 查询的结束时间，单位毫秒；整型；不包括当前时间点
    - name: skip
      type: int64
      desc: 跳过的数据数量
    - name: limit
      type: int64
      desc: 数据大小限制
    - name: sorts
      type: ColumnSort[]
      desc: ColumnSort类型，可以参考tsdb column_object.ColumnSort的定义；暂时不要传值，性能有问题
    - name: func_fields
      type: UserFunc[]
      desc: 和fields一起返回数据，名字会覆盖fields的值；UserFunc类型数组
    - name: without_total
      type: bool
      desc: 不返回总数
  response:
    fields:
    - name: code
      type: int
      desc: 响应码
    - name: message
      type: string
      desc: 响应消息
    - name: page
      type: int64
      desc: 当前页
    - name: page_size
      type: int64
      desc: 页数大小
    - name: total
      type: int64
      desc: 数据总数
    - name: data
      type: map[]
      desc: 返回的数据
  semantic_gaps: []
  port: 8152
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
