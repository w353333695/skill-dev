- operation_key: logic.artifact|POST|/v2/workspace/{packageId}/file
  method: POST
  path: /v2/workspace/{packageId}/file
  raw_paths:
    backend: /v2/workspace/:packageId/file
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.artifact
  request:
    fields:
    - name: null
      type: ''
      desc: ''
    - name: name
      type: string
      desc: rename的新文件名, 不能包含 "/"
    - name: path
      type: file_path
      desc: 要操作的文件、目录路径
    - name: encoding
      type: string
      desc: 参数path的编码格式
    - name: op
      type: string
      desc: "文件操作类型包括\n文件操作类型:\n    删除  ->  delete\n    重命名  ->  rename\n    修改权限\
        \  ->  chmod\n    查询属性和md5 ->  info\n    查看文件列表  -> list\n    创建目录 -> mkdir\n\
        \    下载 -> download"
    - name: perm
      type: file_perm
      desc: chmod、mkdir新文件权限（0755, 0644)
    - name: flatten
      type: pseudo_bool
      desc: 路径扁平化
    - name: workspaceBaseId
      type: string
      desc: 工作区基线版本, 此参数如果传入且与真正的基线版本不一致时将报错
    - name: ignoreCase
      type: bool
      desc: 是否忽略大小写重名(只处理Windows平台制品)
  response:
    fields: []
  semantic_gaps: []
  port: 8175
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
