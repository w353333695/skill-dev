  raw_paths:
    backend: /object/:object_id/relation/:relation_side_id/instance/:instance_id
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb.service
  request:
    fields:
    - name: object_id
      type: object_id
      desc: 模型对象ID
    - name: relation_side_id
      type: string
      desc: 关系 sideId
    - name: instance_id
      type: string
      desc: 实例ID
    - name: query_relation
      type: map
      desc: 对端属性查询条件
    - name: only_my_instance
      type: bool
      desc: 当为 true 时，只搜索与我相关实例
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: relation_limit
      type: int
      desc: 限制fields所带出的关系的数量， 0为不限制，全局配置
    - name: fields
      type: string[]
      desc: '指定对端模型返回字段(支持通过父模型指定子模型属性)(支持关系数据的二级jsonPath格式的指定字段如clusters.name), e.g.:
        [name, instanceId]'
    - name: sort
      type: object[]
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序, 2表示自然升序， -2表示自然降序) e.g.: [{ key:
        instanceId, order: 1}]'
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
