- operation_key: logic.cmdb.service|POST|/object/{objectId}/instance/aggregate
  method: POST
  path: /object/{objectId}/instance/aggregate
  raw_paths:
    backend: /object/:objectId/instance/aggregate
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb.service
  request:
    fields:
    - name: objectId
      type: object_id
      desc: URL中资源模型ID
    - name: query
      type: map
      desc: 查询条件,与[实例搜索接口]的query字段一致
    - name: fields
      type: map
      desc: 过滤字段
    - name: sort
      type: object[]
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序) e.g.: { instanceId: 1 }'
    - name: permission
      type: string[]
      desc: 按照权限过滤(通用实例都有`read`, `update`, `delete`权限控制, 主机实例在通用实例权限基础上有额外的`operate`权限,
        应用实例在通用实例权限基础上有额外的`developClusterOperate`, `testClusterOperate`, `prereleaseClusterOperate`,
        `productionClusterOperate`权限)
    - name: only_my_instance
      type: bool
      desc: 是否只获取与自己有关的那部分数据, 默认为false
    - name: aggregate_key
      type: string
      desc: 聚合属性id（只支持字符类型）
  response:
    fields:
    - name: list
      type: object[]
      desc: 聚合结果
  semantic_gaps: []
  port: 8079
