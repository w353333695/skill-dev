- operation_key: logic.cmdb.service|GET|/change/history
  method: GET
  path: /change/history
  raw_paths:
    backend: /change/history
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb.service
  request:
    fields:
    - name: nextToken
      type: string
      desc: 查询凭证（Token）。取值为上一次调用该接口返回的 nextToken 参数值，初次调用接口时无需设置该参数。
    - name: maxResults
      type: int
      desc: 分页查询时每页的最大条目数。默认10，最大3000。
    - name: page
      type: int
      desc: 页码。从1开始。推荐使用 nextToken 与 maxResults 完成分页查询操作。
    - name: pageSize
      type: int
      desc: 每页条数。默认100，最大3000。推荐使用 nextToken 与 maxResults 完成分页查询操作。
    - name: system
      type: string
      desc: 系统名称
    - name: target_name
      type: string
      desc: 目标名称(工具名/流程名/对象名/实例名)
    - name: target_category
      type: string
      desc: 目标分组
    - name: target_id
      type: string
      desc: 目标名称(多个以逗号分隔,且建议只传递target_id)
    - name: event_id
      type: string
      desc: 事件id
    - name: parent_event_id
      type: string
      desc: 父事件id
    - name: operator
      type: string
      desc: 操作人
    - name: event
      type: string
      desc: 事件名称
    - name: exclude_event
      type: string
      desc: 排除事件名称
    - name: exclude_system
      type: string
      desc: 排除的系统名称
    - name: memo
      type: string
      desc: 事件备注
    - name: with_children
      type: bool
      desc: 是否查询子事件（true查询子事件，false不查询子时间，默认false)
    - name: user
      type: string
      desc: 通知相关人（包含operator和notifier)
    - name: start_time
      type: string
      desc: 开始时间。格式为 `2006-01-02 15:04:05`
    - name: end_time
      type: string
      desc: 截止时间。格式为 `2006-01-02 15:04:05`
    - name: without_total
      type: bool
      desc: 是否不需要查询总数
    - name: topic
      type: string
      desc: topic
    - name: query
      type: string
      desc: query
    - name: ctime_order
      type: string
      desc: ctime_order 默认 desc
    - name: skip
      type: int
      desc: skip
    - name: limit
      type: int
      desc: limit
    - name: field_id
      type: string
      desc: 模型属性或者关系的边id
  response:
    fields:
    - name: list
      type: CmdbChangeHistory[]
      desc: OperationLog 列表
    - name: nextToken
      type: string
      desc: 本次调用返回的查询凭证（Token）。当该返回值为空时，表示该页为末页，不再有后续页。
    - name: page
      type: int
      desc: 页码。使用 maxResults 和 nextToken 参数进行分页查询时，返回的 page 参数值无意义。
    - name: pageSize
      type: int
      desc: 页大小。使用 maxResults 和 nextToken 参数进行分页查询时，返回的 pageSize 参数值无意义。
    - name: total
      type: int
      desc: 总条数。使用 maxResults 和 nextToken 参数进行分页查询时，返回的 total 参数值无意义。
  semantic_gaps: []
  port: 8079
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
