- operation_key: logic.cmdb.service|POST|/v1/object/{objectId}/instance/honeycomb
  method: POST
  path: /v1/object/{objectId}/instance/honeycomb
  raw_paths:
    backend: /v1/object/:objectId/instance/honeycomb
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb.service
  request:
    fields:
    - name: objectId
      type: object_id
      desc: URL中资源模型ID
    - name: query
      type: map
      desc: 查询条件,与[实例搜索接口]的query字段说明一致
    - name: permission
      type: string[]
      desc: 按照权限过滤(通用实例都有`read`, `update`, `delete`权限控制, 主机实例在通用实例权限基础上有额外的`operate`权限,
        应用实例在通用实例权限基础上有额外的`developClusterOperate`, `testClusterOperate`, `prereleaseClusterOperate`,
        `productionClusterOperate`权限)
    - name: onlyMyInstance
      type: bool
      desc: 是否只获取与自己有关的那部分数据, 默认为false
    - name: groupFields
      type: string[]
      desc: 分组字段（name，owner.#showKey）
    - name: extFields
      type: string[]
      desc: 额外实例字段
    - name: cmdbFields
      type: string[]
      desc: 实例cmdb字段
    - name: groupFieldsDesc
      type: string[]
      desc: 分组字段描述
    - name: fillByMetric
      type: object
      desc: 用来填充颜色的指标
    - name: sizeByMetric
      type: object
      desc: 用来设置大小的指标
    - name: aggregation
      type: string
      desc: 指标数据汇聚方式（枚举值：avg、sum、max、min、increase、rate、irate、last，默认last）
    - name: havings
      type: map[]
      desc: having过滤参数
  response:
    fields:
    - name: list
      type: HoneycombGroup[]
      desc: 分组列表
    - name: fillByMetricMin
      type: float
      desc: 用于填充颜色的指标值最小值
    - name: fillByMetricMax
      type: float
      desc: 用于填充颜色的指标值最大值
    - name: sizeByMetricMin
      type: float
      desc: 用于设置尺寸的指标值最小值
    - name: sizeByMetricMax
      type: float
      desc: 用于设置尺寸的指标值最大值
    - name: total
      type: int
      desc: 实例总数
  semantic_gaps: []
  port: 8079
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
