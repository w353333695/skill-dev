- operation_key: logic.easy_work_service|POST|/api/easy_work_service/v1/proxy/cmdb/post_search/object/{objectId}/instance/_search
  method: POST
  path: /api/easy_work_service/v1/proxy/cmdb/post_search/object/{objectId}/instance/_search
  raw_paths:
    backend: /api/easy_work_service/v1/proxy/cmdb/post_search/object/:objectId/instance/_search
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.easy_work_service
  request:
    fields:
    - name: objectId
      type: object_id
      desc: 模型对象ID
    - name: query
      type: map
      desc: 'e.g.: { name: { $like: ''%q%'' } }, { $or: [{ name: { $like: ''%q%''
        }}] }'
    - name: fields
      type: map
      desc: 'e.g.: { instanceId: true, name: true, owner.name: true}， *代表所有普通属性， 注意：建议都指定fields，按需拉取字段，不然有可能返回数据量太大而导致接口慢系统不稳定'
    - name: only_my_instance
      type: bool
      desc: 当为 true 时，只搜索与我相关实例
    - name: only_relation_view
      type: bool
      desc: 对于关联的实例数据是否只获取 relation_view 中指定的属性， 这个字段为 true 时， 会覆盖 fields 字段中指定的二级字段设置
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
    - name: sort
      type: map
      desc: '按字段排序， 留空默认按照实例ID降序排序(1表示升序， -1表示降序) e.g.: { instanceId: 1 }'
    - name: permission
      type: string[]
      desc: '按照权限过滤(通用实例都有 read， update， delete 权限控制， 主机实例在通用实例权限基础上有额外的 operate 权限，
        应用实例在通用实例权限基础上有额外的 developClusterOperate， testClusterOperate， prereleaseClusterOperate，
        productionClusterOperate 权限) e.g.: [ "operate", "update" ]'
    - name: relation_limit
      type: int
      desc: 限制fields所带出的关系的数量， 0为不限制，全局配置
    - name: limitations
      type: object[]
      desc: 单独指定关系的limit与sort
  response:
    fields:
    - name: list
      type: map[]
      desc: instance list
    - name: total
      type: int
      desc: 实例总数
    - name: page
      type: page
      desc: 页码
    - name: page_size
      type: page_size
      desc: 页大小
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
