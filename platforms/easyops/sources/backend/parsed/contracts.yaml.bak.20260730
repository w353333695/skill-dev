- operation_key: logic.cmdb_operation|POST|/api/v1/cmdb_operation/exception/instance/list
  method: POST
  path: /api/v1/cmdb_operation/exception/instance/list
  raw_paths:
    backend: /api/v1/cmdb_operation/exception/instance/list
    frontend: ''
  path_source: backend_contract
  path_confidence: high
  service: logic.cmdb_operation
  request:
    fields:
    - name: execId
      type: string
      desc: 执行id，如果不传，默认获取最近的一次执行详情
    - name: objectId
      type: string
      desc: 模型ID
    - name: instanceId
      type: string
      desc: 实例ID
    - name: abnormalFieldId
      type: string
      desc: 异常字段ID（属性或关系），用于快速筛选，筛选该字段存在任意类型异常的实例
    - name: incompleteAttr
      type: string
      desc: 不完整属性ID，筛选该属性为空值的实例
    - name: nonCompliantAttr
      type: string
      desc: 不合规属性ID，筛选该属性不合规的实例
    - name: nonCompliantRelation
      type: string
      desc: 不合规关系ID，筛选该关系不合规的实例
    - name: viewType
      type: string
      desc: 视角类型("global"-全局, "group"-管理组, "my"-我的)
    - name: groupId
      type: string
      desc: 管理组ID，viewType=group时可指定
    - name: qualityTypes
      type: string[]
      desc: 质量分类筛选("field"-空值, "strange"-属性不合规, "relation"-关系不合规)
    - name: ownerFilter
      type: string[]
      desc: 负责人过滤
    - name: keyword
      type: string
      desc: 实例名称搜索关键词
    - name: startDate
      type: string
      desc: 开始日期，格式YYYY-MM-DD
    - name: sortField
      type: string
      desc: 排序字段，支持showKey(实例名称)、checkTime(稽核时间)，默认showKey
    - name: sortOrder
      type: string
      desc: 排序方向，asc-升序，desc-降序，默认asc
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 页大小
  response:
    fields:
    - name: list
      type: object[]
      desc: 异常实例列表
    - name: page
      type: page
      desc: 页码
    - name: pageSize
      type: page_size
      desc: 页大小
    - name: total
      type: int
      desc: 总数
    - name: columns
      type: object[]
      desc: 动态列定义（前端渲染表头用，按该模型配置了稽核规则的属性/关系生成）
    - name: summary
      type: object[]
      desc: 按属性/关系维度的异常统计（用于顶部异常统计标签展示）
  semantic_gaps: []
  port: null
  source_file: FLOW_BUILDER_API_CONTRACT@EASYOPS.json
