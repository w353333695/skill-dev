# Workspace Git repository
# 取消从父目录继承的所有忽略规则（workspace 是独立仓库）
!*
!*/

# Dependencies
node_modules/

# Build outputs
build/
out/

# IDE
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
.text-to-image
.confluence_cookie
.fetch_state.json

# Python
__pycache__/
*.pyc
.venv/

# Temp & build artifacts
tmp/
workspace-all.zip

# Runtime artifacts（工具运行产物：截图/导出结果等，按工具追加）
.screenshot-images/

# api-orchestrator 本地状态（运行态缓存/会话产物，不入库）
.api-orchestrator/

# 敏感凭证与公司内部源码（绝不进版本库）
platforms/*/auth/
platforms/*/sources/raw/
.env
.env.*

# 参考资料（onboarding 输入：API 文档/抓包/源码/场景，公司内部，不入库）
data/
resources/

# fintech-sync：本地工具（含平台模型导出/数据转储，不入库）
apps/fintech-sync/

# SDD scratch
.superpowers/

.claude/settings.json

# 项目内临时区（AGENTS.md 约定：本地凭证/中间产物，不入库）
.local/
