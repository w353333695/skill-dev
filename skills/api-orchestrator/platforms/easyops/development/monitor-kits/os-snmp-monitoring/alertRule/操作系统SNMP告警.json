{
  "alertConditionStrategy": [
    {
      "alertInterval": 60,
      "conditionType": "metricThreshold",
      "conditionsOperator": "or",
      "effectiveTime": {"type":"static","static":{"dayStartTime":"00:00:00","dayEndTime":"23:59:59","dayOfWeek":[1,2,3,4,5,6,0]}},
      "eventFilterQuery": {"type":"filter","filter":{"conditionGroup":[{"conditionList":[]}] }},
      "instanceId":"os-snmp-alert-strategy",
      "multiConditions":[
        {"metricName":"os.snmp.available","mode":"static","type":"unequal","threshold":1,"alertCount":3,"recoverCount":5,"detectWindow":3,"comparators":[{"level":"warning","threshold":1,"displayThreshold":1,"type":"unequal","tolerance":0}]},
        {"metricName":"os.cpu.util","mode":"static","type":"bigger_than","threshold":80,"alertCount":3,"recoverCount":5,"detectWindow":3,"comparators":[{"level":"warning","threshold":80,"displayThreshold":80,"type":"bigger_than","tolerance":0},{"level":"critical","threshold":95,"displayThreshold":95,"type":"bigger_than","tolerance":0}]},
        {"metricName":"os.mem.pused","mode":"static","type":"bigger_than","threshold":80,"alertCount":3,"recoverCount":5,"detectWindow":3,"comparators":[{"level":"warning","threshold":80,"displayThreshold":80,"type":"bigger_than","tolerance":0},{"level":"critical","threshold":90,"displayThreshold":90,"type":"bigger_than","tolerance":0}]},
        {"metricName":"os.fs.pused","mode":"static","type":"bigger_than","threshold":80,"alertCount":3,"recoverCount":5,"detectWindow":3,"comparators":[{"level":"warning","threshold":80,"displayThreshold":80,"type":"bigger_than","tolerance":0},{"level":"critical","threshold":90,"displayThreshold":90,"type":"bigger_than","tolerance":0}]},
        {"metricName":"os.if.oper.status","mode":"static","type":"equal","threshold":2,"alertCount":3,"recoverCount":5,"detectWindow":3,"comparators":[{"level":"warning","threshold":2,"displayThreshold":2,"type":"equal","tolerance":0}]}
      ],
      "objectId":"OS_SNMP@ONEMODEL",
      "priority":"warning"
    }
  ]
}
